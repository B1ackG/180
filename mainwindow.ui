  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">
QGroupBox#groupBox_2, QGroupBox#groupBox, QGroupBox#groupBox_StepMove, QGroupBox#groupBox_SixAxies_StepMove, QGroupBox#groupBox_4 {
  border-radius: 10px;
  margin-top: 14px;
}
QGroupBox#groupBox_2 {
  border: 1px solid rgba(0, 200, 255, 0.45);
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(12, 34, 58, 0.72),
                              stop:1 rgba(8, 24, 42, 0.64));
}
QGroupBox#groupBox {
  border: 1px solid rgba(0, 170, 255, 0.38);
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(14, 38, 64, 0.70),
                              stop:1 rgba(10, 28, 48, 0.60));
}
QGroupBox#groupBox_4 {
  border: 1px solid rgba(255, 120, 120, 0.58);
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(76, 18, 18, 0.70),
                              stop:1 rgba(56, 16, 16, 0.62));
}
QGroupBox#groupBox_StepMove, QGroupBox#groupBox_SixAxies_StepMove {
  border: 1px solid rgba(0, 220, 255, 0.52);
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 rgba(12, 36, 64, 0.82),
                              stop:1 rgba(8, 26, 48, 0.70));
}

QGroupBox#groupBox_2::title, QGroupBox#groupBox::title, QGroupBox#groupBox_StepMove::title, QGroupBox#groupBox_SixAxies_StepMove::title, QGroupBox#groupBox_4::title {
  subcontrol-origin: margin;
  subcontrol-position: top center;
  padding: 1px 12px;
  font-weight: 700;
  letter-spacing: 1px;
  border-radius: 5px;
}
QGroupBox#groupBox_2::title { color: #9fe7ff; background: rgba(8, 24, 42, 0.92); border-bottom: 1px solid rgba(0, 200, 255, 0.52); }
QGroupBox#groupBox::title { color: #c0e8ff; background: rgba(10, 28, 48, 0.92); border-bottom: 1px solid rgba(0, 170, 255, 0.42); }
QGroupBox#groupBox_StepMove::title, QGroupBox#groupBox_SixAxies_StepMove::title { color: #9ff4ff; background: rgba(8, 30, 50, 0.95); border-bottom: 1px solid rgba(0, 220, 255, 0.58); }
QGroupBox#groupBox_4::title { color: #ffd0d0; background: rgba(56, 16, 16, 0.92); border-bottom: 1px solid rgba(255, 120, 120, 0.62); }

#groupBox_StepMove QLabel,
#groupBox_SixAxies_StepMove QLabel {
  color: #d8f6ff;
  font-weight: 600;
  font-size: 13px;
}

#groupBox_StepMove QToolButton,
#groupBox_SixAxies_StepMove QToolButton,
#groupBox_StepMove QLineEdit,
#groupBox_SixAxies_StepMove QLineEdit {
  color: #ffffff;
  background: rgba(3, 18, 34, 0.84);
  border: 1px solid rgba(0, 198, 255, 0.55);
  border-radius: 8px;
  padding: 4px 8px;
  min-height: 34px;
}

#groupBox_StepMove QToolButton,
#groupBox_SixAxies_StepMove QToolButton {
  text-align: left;
  padding-left: 10px;
  font-size: 13px;
  font-weight: 700;
}

#groupBox_StepMove QToolButton:hover,
#groupBox_SixAxies_StepMove QToolButton:hover,
#groupBox_StepMove QLineEdit:hover,
#groupBox_SixAxies_StepMove QLineEdit:hover {
  border: 1px solid #6fe7ff;
  background: rgba(5, 24, 44, 0.92);
}

#groupBox_StepMove QToolButton:checked,
#groupBox_SixAxies_StepMove QToolButton:checked {
  background: rgba(0, 130, 200, 0.95);
  border: 1px solid #9fe7ff;
  color: #ffffff;
}

#groupBox_StepMove QLineEdit,
#groupBox_SixAxies_StepMove QLineEdit {
  font-family: &quot;Consolas&quot;;
  font-size: 14px;
  font-weight: 700;
}

#groupBox_StepMove QLineEdit:focus,
#groupBox_SixAxies_StepMove QLineEdit:focus {
  border: 1px solid #9ff4ff;
}

#groupBox_2 QToolButton, #groupBox QToolButton {
  color: #dff6ff;
  background: rgba(16, 52, 85, 0.70);
  border: 1px solid rgba(0, 200, 255, 0.40);
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 36px;
}
#groupBox_2 QToolButton:hover, #groupBox QToolButton:hover {
  background: rgba(24, 80, 125, 0.86);
  border: 1px solid #00c8ff;
}

#TBtn_RemoveWarning {
  color: #fff4f4;
  background: rgba(128, 24, 24, 0.92);
  border: 1px solid #ff9a9a;
  border-radius: 8px;
  padding: 3px 8px;
  min-height: 36px;
}
#TBtn_RemoveWarning:hover {
  background: rgba(176, 35, 35, 0.96);
  border: 1px solid #ffd6d6;
}

#groupBox QToolButton:checked {
  background: rgba(0, 130, 200, 0.95);
  border: 1px solid #9fe7ff;
  color: #ffffff;
}

</string>
