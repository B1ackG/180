        <property name="styleSheet">
         <string notr="true">font-size: 22px;
    letter-spacing: 1px;
    line-height: 1.3;
    
    /* 白色文字配蓝色边框 */
    color: #ffffff;
    border-left: 5px solid qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #00aaff,
        stop: 1 #0066cc
    );
    
    
    /* 背景效果 */
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(0, 60, 120, 0.2),
        stop: 0.5 rgba(0, 40, 80, 0.1),
        stop: 1 rgba(0, 60, 120, 0.2)
    );
    
    /* 布局 */
    padding: 2px 3px;
    margin: 10px 0 6px 0;
    border-radius: 0 6px 6px 0;
    
    /* 装饰性下划线 */
    border-bottom: 1px solid rgba(0, 150, 255, 0.3);
    </string>
